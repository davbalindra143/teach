FROM python:3.12-slim

WORKDIR /app

COPY frontend_requirements.txt .
RUN pip install --no-cache-dir -r frontend_requirements.txt

COPY frontend_app.py .

EXPOSE 8501
CMD ["streamlit", "run", "frontend_app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"]